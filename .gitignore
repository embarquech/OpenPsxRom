# Whitelist: only the project sources are published.
# Never commit memory card dumps, firmware dumps (Xplorer FCD, Unirom...), BIOS images,
# build outputs or machine-specific scripts.
/*
!/.gitignore
!/LICENSE
!/README.md
!/Makefile
!/Kconfig
!/configs/
!/rom.ld
!/exe.ld
!/exe_lo.ld
!/rom_bank3.ld
!/rom_ar.ld
!/src/
!/core/
!/test/
!/tests/
!/tools/
!/docs/

/tools/*
!/tools/elf2exe.py
!/tools/mkdisc.py
!/tools/packrom.py
!/tools/pad.py
!/tools/omc.py
!/tools/run_duck.ps1
!/tools/shot.ps1
!/tools/boot_test.ps1
!/tools/rom2_test.ps1
!/tools/psxshot.py
!/tools/caetla_reloc.py
!/tools/arcart_image.py
!/tools/psx.py
!/tools/kconfig.py
!/tools/cheats.py

__pycache__/
*.o
*.bin
*.rom
*.mcr
*.exe

# Sphinx output
/docs/_build/

# local build configuration (make menuconfig)
/.config
/.config.old
/configs/*.old
